{
  "manifest_version": 3,
  "name": "Reels Playlist",
  "version": "0.5.0",
  "description": "Salva Reels do Instagram numa playlist para assistir depois na TV.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Salvar Reel na playlist (Alt+Shift+S)",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://firestore.googleapis.com/*",
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Salvar o Reel aberto"
    }
  }
}