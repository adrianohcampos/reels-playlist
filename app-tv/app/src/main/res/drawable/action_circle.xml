<?xml version="1.0" encoding="utf-8"?>
<!-- Botão redondo das ações do player: focado = branco, ativo = cor de destaque -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="oval"><solid android:color="#FFFFFF" /></shape></item>
    <item android:state_activated="true"><shape android:shape="oval"><solid android:color="@color/accent" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="oval"><solid android:color="#66FFFFFF" /></shape></item>
    <item><shape android:shape="oval"><solid android:color="#33FFFFFF" /></shape></item>
</selector>
