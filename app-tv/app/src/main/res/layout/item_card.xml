<?xml version="1.0" encoding="utf-8"?>
<!-- Card 3:4 com capa, nome e etiquetas. A moldura externa mostra o foco do controle remoto. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/card_focus"
    android:clickable="true"
    android:focusable="true"
    android:padding="3dp">

    <br.reels.tv.AspectFrameLayout
        android:id="@+id/inner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_inner"
        android:foreground="?android:attr/selectableItemBackground">

        <!-- Sem capa: ícone e código -->
        <LinearLayout
            android:id="@+id/placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/placeholderIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:alpha="0.5"
                android:src="@drawable/ic_play" />

            <TextView
                android:id="@+id/placeholderText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />

        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/pill_bg"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/fav"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/pill_bg"
            android:padding="5dp"
            android:src="@drawable/ic_heart"
            android:tint="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:maxLines="1"
            android:padding="10dp"
            android:shadowColor="#000000"
            android:shadowRadius="4"
            android:textSize="14sp"
            android:textStyle="bold" />
    </br.reels.tv.AspectFrameLayout>
</FrameLayout>
