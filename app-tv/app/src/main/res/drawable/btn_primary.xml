<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape><solid android:color="#FFFFFF" /><corners android:radius="28dp" /></shape></item>
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape><gradient android:angle="0" android:startColor="@color/accent" android:endColor="@color/accent2" /><corners android:radius="26dp" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape><gradient android:angle="0" android:startColor="#D93060" android:endColor="#E07530" /><corners android:radius="28dp" /></shape>
    </item>
    <item>
        <shape><gradient android:angle="0" android:startColor="@color/accent" android:endColor="@color/accent2" /><corners android:radius="28dp" /></shape>
    </item>
</selector>
