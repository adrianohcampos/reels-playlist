rules_version = '2';

// Segurança por "código secreto": só quem conhece o código da playlist
// (32 caracteres aleatórios) consegue ler ou escrever nela.
// Ninguém consegue listar as playlists existentes.
service cloud.firestore {
  match /databases/{database}/documents {

    match /playlists/{code} {
      function ok() { return code.size() >= 24; }

      // Reels salvos
      match /items/{itemId} {
        allow read, delete: if ok();

        allow create: if ok()
          && request.resource.data.keys().hasOnly(['url', 'shortcode', 'addedAt', 'watched', 'source', 'title', 'favorite'])
          && request.resource.data.shortcode == itemId
          && request.resource.data.url == 'https://www.instagram.com/reel/' + itemId + '/'
          && request.resource.data.watched is bool
          && request.resource.data.addedAt is timestamp;

        // Só dá pra marcar visto/favorito ou preencher o título
        allow update: if ok()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['watched', 'title', 'favorite']);
      }

      // Capas (thumbnails) pequenas em JPEG/base64, geradas pela TV ou pela extensão
      match /thumbs/{sc} {
        allow read, delete: if ok();
        allow create, update: if ok()
          && request.resource.data.keys().hasOnly(['jpg', 'source'])
          && request.resource.data.jpg is string
          && request.resource.data.jpg.size() < 120000;
      }

      // Aparelhos conectados (TV, celular, Chrome)
      match /devices/{dev} {
        allow read, delete: if ok();
        allow create, update: if ok()
          && dev.size() >= 16 && dev.size() <= 40
          && request.resource.data.keys().hasOnly(['name', 'type', 'pairedAt', 'lastSeen', 'revoked'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
          && request.resource.data.type in ['tv', 'celular', 'desktop', 'navegador']
          && request.resource.data.revoked is bool;
      }
    }

    // Pareamento: quem já está conectado grava pairing/{PIN de 8 letras} com o código da playlist.
    // O aparelho novo lê (precisa saber o PIN exato, não dá pra listar) e apaga logo em seguida.
    match /pairing/{pin} {
      allow get, delete: if pin.size() == 8;
      allow create: if pin.size() == 8
        && request.resource.data.keys().hasOnly(['playlistCode', 'createdAt'])
        && request.resource.data.playlistCode is string
        && request.resource.data.playlistCode.size() >= 24;
    }

    // Qualquer outra coisa: bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
